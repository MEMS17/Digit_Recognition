# Copy this file to .env.production. Do not commit the resulting file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.postal.example.fr
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=postal_ocr
CORS_ALLOWED_ORIGINS=https://frontend.vercel.app
# Absolute host path mounted read-only in the IA service. It must contain both
# mnist_tuning_v1/cnn_tuned.keras and postal_digit_synthetic_v1/postal_digit_cnn.keras.
MODEL_DIR_HOST=/srv/digit-recognition/models
